escription":"April 2025","sidebar":"projectsSidebar"},"projects/school/light-show":{"id":"projects/school/light-show","title":"Roomba Light Show","description":"December 2025","sidebar":"projectsSidebar"},"projects/school/motor-control":{"id":"projects/school/motor-control","title":"DC Motor Position Control","description":"August 2024 - December 2024","sidebar":"projectsSidebar"},"projects/school/ping-pong":{"id":"projects/school/ping-pong","title":"Ping Pong Ball Feedback Controller","description":"February 2024 - April 2024","sidebar":"projectsSidebar"},"projects/school/quad-sim":{"id":"projects/school/quad-sim","title":"Modeling and Simulation of a Quadcopter","description":"November 2024 - December 2024","sidebar":"projectsSidebar"},"projects/school/robot-dog":{"id":"projects/school/robot-dog","title":"Tactical Robo-Dog","description":"April 2026","sidebar":"projectsSidebar"},"projects/school/search-and-rescue":{"id":"projects/school/search-and-rescue","title":"Search and Rescue Rover","description":"April 2026","sidebar":"projectsSidebar"},"projects/school/tag":{"id":"projects/school/tag","title":"Tag! Pygame","description":"November 2023","sidebar":"projectsSidebar"},"projects/school/tic-tac-toe":{"id":"projects/school/tic-tac-toe","title":"Tic-Tac-Toe Robot","description":"November 2025","sidebar":"projectsSidebar"},"projects/school/turret":{"id":"projects/school/turret","title":"Automated Turret","description":"January 2025 - April 2025","sidebar":"projectsSidebar"},"tutorials/code/barber-scheduler":{"id":"tutorials/code/barber-scheduler","title":"Automatic Barber Scheduler","description":"May 2024","sidebar":"tutorialsSidebar"},"tutorials/index":{"id":"tutorials/index","title":"Tutorials","description":"<CardSection","sidebar":"tutorialsSidebar"},"tutorials/robots/ft-explorer-vtol":{"id":"tutorials/robots/ft-explorer-vtol","title":"FT Explorer VTOL","description":"August 2018 - September 2019","sidebar":"tutorialsSidebar"},"tutorials/robots/mavrospy/index":{"id":"tutorials/robots/mavrospy/index","title":"MAVROSPY","description":"June 2024 - May 2025","sidebar":"tutorialsSidebar"},"tutorials/robots/mavrospy/mocap":{"id":"tutorials/robots/mavrospy/mocap","title":"Motion Capture","description":"Motion capture allows for non-GPS navigation by sending pose estimation data to the flight controller's EKF. ROS makes this easy as there are drivers and packages that allow us to publish pose topics into the ROS framework. We can then relay those topics directly into MAVROS which will then send the poses to the flight controller.","sidebar":"tutorialsSidebar"},"tutorials/robots/mavrospy/outdoor":{"id":"tutorials/robots/mavrospy/outdoor","title":"GPS Navigation","description":"We can run an outdoor demonstration of MAVROSPY via the outdoor.launch file. However, we need to make sure it runs on boot as we would not be able to SSH to our companion computer on the field.","sidebar":"tutorialsSidebar"},"tutorials/robots/mavrospy/setup":{"id":"tutorials/robots/mavrospy/setup","title":"Hardware Setup","description":"MAVROSPY is supported on a PX4 (v1.15.4) flight controller with a Jetson Orin Nano (JetPack 6.2), Jetson Nano (JetPack 4.6), or a RPi4 (Ubuntu 22.04 MATE) companion computer. Additionally, it supported on ROS2 Humble and ROS1 Noetic.","sidebar":"tutorialsSidebar"},"tutorials/robots/mavrospy/sim":{"id":"tutorials/robots/mavrospy/sim","title":"Simulation","description":"An additional benefit of using ROS is that it allows users to easily develop simulators such as Gazebo with their robotic projects. This is crucial for rapid development as it allows you to test your scripts without having to risk crashing your physical drone.","sidebar":"tutorialsSidebar"},"tutorials/robots/reading-eye":{"id":"tutorials/robots/reading-eye","title":"Reading Eye For The Blind","description":"December 2019 - February 2020","sidebar":"tutorialsSidebar"},"tutorials/robots/recycle-sorting-robot":{"id":"tutorials/robots/recycle-sorting-robot","title":"Recycle Sorting Robotic Arm With Computer Vision","description":"June 2019 - July 2019","sidebar":"tutorialsSidebar"},"tutorials/robots/sar-drone":{"id":"tutorials/robots/sar-drone","title":"Autonomous Search And Rescue Drone","description":"July 2018 - August 2020","sidebar":"tutorialsSidebar"},"tutorials/robots/vslam/flight":{"id":"tutorials/robots/vslam/flight","title":"Flight Demo","description":"Make sure you have completed the Hardware Setup Guide before running this demo.","sidebar":"tutorialsSidebar"},"tutorials/robots/vslam/index":{"id":"tutorials/robots/vslam/index","title":"GPS-Denied UAV with Visual SLAM","description":"August 2024 - June 2025","sidebar":"tutorialsSidebar"},"tutorials/robots/vslam/setup":{"id":"tutorials/robots/vslam/setup","title":"Hardware Setup","description":"VSLAM UAV is supported on a PX4 (v1.15.4) flight controller, Intel D435i camera, and a Jetson Orin Nano (JetPack 6.2) companion computer.","sidebar":"tutorialsSidebar"},"tutorials/robots/vslam/sim":{"id":"tutorials/robots/vslam/sim","title":"Simulation","description":"Simulating the VSLAM UAV pipeline is a great way to test your code without the need for a physical drone. This tutorial will show you how to set up the VSLAM UAV simulator on your local machine using Docker and Isaac Sim 4.2.","sidebar":"tutorialsSidebar"},"tutorials/robots/vslam/valid":{"id":"tutorials/robots/vslam/valid","title":"Validation","description":"This page outlines an optional procedure that can be used to validate the successful installation and configuration of your VSLAM system. It requires the use of a motion capture system to provide ground truth data.","sidebar":"tutorialsSidebar"}}}}