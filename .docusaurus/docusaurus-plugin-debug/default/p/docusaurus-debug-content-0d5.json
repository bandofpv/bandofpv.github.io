malink":"/docs/tutorials/robots/mavrospy/"},"next":{"title":"GPS Navigation","permalink":"/docs/tutorials/robots/mavrospy/outdoor"}},{"id":"tutorials/robots/mavrospy/sim","title":"Simulation","description":"An additional benefit of using ROS is that it allows users to easily develop simulators such as Gazebo with their robotic projects. This is crucial for rapid development as it allows you to test your scripts without having to risk crashing your physical drone.","source":"@site/docs/tutorials/robots/mavrospy/sim.mdx","sourceDirName":"tutorials/robots/mavrospy","slug":"/tutorials/robots/mavrospy/sim","permalink":"/docs/tutorials/robots/mavrospy/sim","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":4,"frontMatter":{"sidebar_position":4,"sidebar_label":"Simulation"},"sidebar":"tutorialsSidebar","previous":{"title":"Motion Capture","permalink":"/docs/tutorials/robots/mavrospy/mocap"},"next":{"title":"Search And Rescue Drone","permalink":"/docs/tutorials/robots/sar-drone"}},{"id":"tutorials/robots/reading-eye","title":"Reading Eye For The Blind","description":"December 2019 - February 2020","source":"@site/docs/tutorials/robots/reading-eye.mdx","sourceDirName":"tutorials/robots","slug":"/tutorials/robots/reading-eye","permalink":"/docs/tutorials/robots/reading-eye","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":3,"frontMatter":{"sidebar_position":3,"sidebar_label":"Reading Robot"},"sidebar":"tutorialsSidebar","previous":{"title":"Search And Rescue Drone","permalink":"/docs/tutorials/robots/sar-drone"},"next":{"title":"VTOL Aircraft","permalink":"/docs/tutorials/robots/ft-explorer-vtol"}},{"id":"tutorials/robots/recycle-sorting-robot","title":"Recycle Sorting Robotic Arm With Computer Vision","description":"June 2019 - July 2019","source":"@site/docs/tutorials/robots/recycle-sorting-robot.mdx","sourceDirName":"tutorials/robots","slug":"/tutorials/robots/recycle-sorting-robot","permalink":"/docs/tutorials/robo